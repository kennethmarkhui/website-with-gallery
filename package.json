{
  "name": "website-with-gallery",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "prettier": "prettier --write .",
    "db:generate": "dotenv -e .env.local -- npx prisma generate",
    "db:studio": "dotenv -e .env.local -- npx prisma studio",
    "db:migrate": "dotenv -e .env.local -- npx prisma migrate deploy",
    "db:migrate-dev": "dotenv -e .env.local -- npx prisma migrate dev",
    "db:pull": "dotenv -e .env.local -- npx prisma db pull",
    "db:push": "dotenv -e .env.local -- npx prisma db push",
    "db:seed": "dotenv -e .env.local -- npx prisma db seed",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@formatjs/intl-localematcher": "^0.5.4",
    "@headlessui/react": "^2.1.3",
    "@hookform/resolvers": "^3.9.0",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^5.18.0",
    "@react-spring/web": "^9.7.4",
    "@tanstack/react-query": "^5.52.1",
    "@tanstack/react-query-devtools": "^5.52.1",
    "@tanstack/react-table": "^8.20.1",
    "@use-gesture/react": "^10.3.1",
    "cloudinary": "^2.4.0",
    "clsx": "^2.1.1",
    "formidable": "^3.5.1",
    "negotiator": "^0.6.3",
    "next": "^14.2.6",
    "next-auth": "^4.24.7",
    "next-intl": "^3.19.1",
    "nodemailer": "^6.9.14",
    "nprogress": "^0.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-icons": "^5.3.0",
    "react-photo-album": "^3.0.2",
    "react-use": "^17.5.1",
    "tailwind-merge": "^2.5.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.7",
    "@types/formidable": "^3.4.5",
    "@types/negotiator": "^0.6.3",
    "@types/node": "^22.5.0",
    "@types/nprogress": "^0.2.3",
    "@types/react": "^18.3.4",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.6",
    "postcss": "^8.4.41",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.6",
    "prisma": "^5.18.0",
    "tailwindcss": "^3.4.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  }
}
